  m_Script: {fileID: 11500000, guid: e109a12f585ae684d8b04bd69c300cd0, type: 3}
  m_Name: L0Q1 Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::QuestDialogue
  quest: {fileID: 11400000, guid: f1a98252cbb012c4b9fda547d87d41e6, type: 2}
  before:
    lines:
    - Hello, Ruby. Welcome.
    - Did you come to help us?
    - I'm afraid there's not much left to do in this place.
    - This island is falling apart...
    - Still... there may be time to help my friends.
    - Let's start with the basics. Have you learned how to move yet?
    - Use WASD or the arrow keys to move. Press X to talk to me or others, just like
      you did.
    - The bar in the top-left corner of the screen shows your health.
    - Don't let it run empty, or you'll die.
    - Now that I've taken a good look at you... You seem exhausted.
    - Fruit is scarce around here, but please, take this piece. It should help you
      recover.
    questToGrantAfter: {fileID: 11400000, guid: f1a98252cbb012c4b9fda547d87d41e6,
      type: 2}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
  during:
    lines:
    - Please accept the kiwi I'm giving you.
    questToGrantAfter: {fileID: 0}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
  after:
    lines:
    - You look a bit better now. That's a relief.
    - Well, that's about all I can do for you.
    - My friends aren't far from here.
    - If anyone still needs your help, it's them.
    - Come on. I'll show you the way.
    questToGrantAfter: {fileID: 0}
    onExhausted:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 11400000, guid: 85da3eb3994e6d746a3d038a219053e2, type: 2}
          m_TargetAssemblyTypeName: SceneLoader, Assembly-CSharp
