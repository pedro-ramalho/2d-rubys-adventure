  m_Script: {fileID: 11500000, guid: e109a12f585ae684d8b04bd69c300cd0, type: 3}
  m_Name: L0Q1 Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::QuestDialogue
  quest: {fileID: 11400000, guid: f1a98252cbb012c4b9fda547d87d41e6, type: 2}
  before:
    lines:
    - Hello, Ruby. Welcome.
    - This island is falling apart as you can see.
    - Machines are breaking down, malfunctioning...
    - Releasing so many gaxes and toxins into the air...
    - We need your help to find out what's causing all of this!
    - Let's start with the basics. Have you learned how to move yet?
    - Move with WASD or arrow keys. Press X to talk to me or others, just like you
      did.
    - 'The top left of the screen shows your health bar. '
    - Don't let it run empty, or else you'll die!
    - Now that I've taken a good look at you... You don't seem to be in good shape...
    - 'Fruit is scarce around here, but please, take this piece. It should help you
      recover. '
    questToGrantAfter: {fileID: 11400000, guid: f1a98252cbb012c4b9fda547d87d41e6,
      type: 2}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
  during:
    lines:
    - Please accept the strawberry I'm giving you.
    questToGrantAfter: {fileID: 0}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
  after:
    lines:
    - You look a lot better now! Ready to go.
    - Not to disappoint you or anything but there isn't much to do in this tiny island.
    - I live by myself, and as you can tell, there are no robots to interfere with
      my peace here.
    - You should visit my friend's island. They're nearby and could really use your
      help.
    - Let's get going then.
    questToGrantAfter: {fileID: 0}
    onExhausted:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 11400000, guid: 85da3eb3994e6d746a3d038a219053e2, type: 2}
          m_TargetAssemblyTypeName: SceneLoader, Assembly-CSharp
          m_MethodName: LoadScene
          m_Mode: 5
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: Level 1
            m_BoolArgument: 0
          m_CallState: 2
