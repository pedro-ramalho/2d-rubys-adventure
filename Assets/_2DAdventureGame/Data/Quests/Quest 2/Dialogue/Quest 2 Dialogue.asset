  m_Script: {fileID: 11500000, guid: e109a12f585ae684d8b04bd69c300cd0, type: 3}
  m_Name: Quest 2 Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::QuestDialogue
  quest: {fileID: 11400000, guid: c6776d6eb3e75eb4e9a4bba9c2323d65, type: 2}
  before:
    lines:
    - These robots are a nightmare...
    - Oh! Ruby! I need your help!
    - Have you seen these robots roaming around? They make so much noise, I can't
      even sleep properly at night!
    - I think they're malfunctioning, somehow... could you try to fix them?
    questToGrantAfter: {fileID: 11400000, guid: c6776d6eb3e75eb4e9a4bba9c2323d65,
      type: 2}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
  during:
    lines:
    - I miss it when this place was quiet and peaceful...
    questToGrantAfter: {fileID: 0}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
  after:
    lines:
    - Oh! I can't hear their engines going crazy anymore!
    - Thanks so much Ruby... I'll finally be able to sleep again.
    questToGrantAfter: {fileID: 0}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
