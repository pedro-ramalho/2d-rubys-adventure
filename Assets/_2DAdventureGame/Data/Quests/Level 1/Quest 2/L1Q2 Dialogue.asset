  m_Script: {fileID: 11500000, guid: e109a12f585ae684d8b04bd69c300cd0, type: 3}
  m_Name: L1Q2 Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::QuestDialogue
  quest: {fileID: 11400000, guid: 20cae48561d7de44ab62f2c62cabac6f, type: 2}
  before:
    lines:
    - My, Martha said someone was coming...
    - But I didn't think they'd be so small...
    - Well then, I suppose you came here to deal with these Patrol Robots.
    - They've been malfunctioning lately. Badly. And they're all in desperate need
      of repair.
    - That's your job, far as I understand it.
    - Sure, they ain't gonna fix themselves.
    - You'll need to hit them with something first. Go on, try pressing C and look
      what happens.
    questToGrantAfter: {fileID: 11400000, guid: 20cae48561d7de44ab62f2c62cabac6f,
      type: 2}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
  during:
    lines:
    - The robots ain't gonna fix themselves, you know.
    questToGrantAfter: {fileID: 0}
    onExhausted:
      m_PersistentCalls:
        m_Calls: []
  after:
    lines:
    - Much quieter now... Good.
    - You seem ready.
    - Something strange's going on with our machines lately.
    - It's almost as if someone's been tinkering with them...
    - Deliberately pressing all the wrong buttons.
    - This feels like Marshmallow's doing...
    - Marshmallow is from Sugar Land. They've done something like this in the past
      before.
    - Whatever it is they're plotting, you have to stop them!
    - Don't let their looks deceive you!
    - Come with me!
    questToGrantAfter: {fileID: 0}
    onExhausted:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 11400000, guid: 00de10106742a0a4a9d66f19712f2af1, type: 2}
          m_TargetAssemblyTypeName: SceneLoader, Assembly-CSharp
